# Rename this file to .env before running (never commit real secrets)

# Secret used to sign agent JWTs (change this in any real deployment)
JWT_SECRET=trustledger-hackathon-demo-secret-change-me

# Optional: only needed if you wire in a real LLM call inside
# ml/manipulation_llm.py for Module 4's semantic layer.
# Without it, the rule-based signature layer still works on its own.
LLM_API_KEY=

FLASK_PORT=5000
